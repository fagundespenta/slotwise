# --- Database --------------------------------------------------------------
# Local: run `npx prisma dev` and paste the TCP URL it prints (postgres://...).
# Production: a Neon / Supabase / any PostgreSQL connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Optional - Google sign-in is shown only when both are set.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- App -------------------------------------------------------------------
# Public base URL, used in Stripe redirect URLs and emails.
APP_URL="http://localhost:3000"

# --- Stripe (TEST MODE ONLY) ----------------------------------------------
# Optional - deposits are skipped when unset. Live keys (sk_live_) are rejected.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
